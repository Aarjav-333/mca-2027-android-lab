<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="vertical" android:padding="20dp">
<EditText android:id="@+id/q" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Question" />
<EditText android:id="@+id/a" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option 1" />
<EditText android:id="@+id/b" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option 2" />
<EditText android:id="@+id/c" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option 3" />
<EditText android:id="@+id/d" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option 4" />
<EditText android:id="@+id/ans" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Correct option 1-4" />
<Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add Question" />
<Button android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Logout" />
</LinearLayout></ScrollView>
